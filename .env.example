# =======================================================
# Variáveis de ambiente do aplicativo
# Copie para .env.local (desenvolvimento) e cadastre na Vercel
# (ambientes Production e Preview).
#
# .env.local NUNCA vai para o Git — confira o .gitignore.
# =======================================================

# --- MySQL (VPS) ---------------------------------------
# Aponta para o MySQL existente. Se o ProxySQL for adotado
# (ver ARQUITETURA_APP.md, seção 3.2), muda apenas a porta aqui.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=trakeamento_controle
# 'true' se o servidor exigir TLS. Em produção, prefira true.
MYSQL_SSL=false

# --- Auth.js -------------------------------------------
# Gere com: openssl rand -base64 32
AUTH_SECRET=
# URL pública do app. Em desenvolvimento: http://localhost:3000
AUTH_URL=

# --- Primeiro administrador (uso único) ----------------
# Preencha, rode `npm run seed:admin`, e REMOVA em seguida.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=

# --- n8n ------------------------------------------------
# Base dos webhooks que permanecem no n8n (sincronização e
# importação histórica da Meta). Sem barra no final.
N8N_WEBHOOK_BASE_URL=
# Token enviado no header Authorization para esses webhooks.
# Substitui o Basic Auth de usuário único usado hoje.
# Gere com: openssl rand -hex 32
N8N_WEBHOOK_TOKEN=

# --- Evolution API (conexão de WhatsApp por QR Code) ---
# Endereço público do painel visto pelo servidor da Evolution: é o que
# entra na URL do webhook cadastrada na instância. Sem valor, o padrão é
# o próprio AUTH_URL.
#
# ATENÇÃO ao rodar a Evolution em outra máquina (VPS) e o painel na
# Vercel: se este valor (ou o AUTH_URL) for http://localhost:3000, a
# instância conecta e o número aparece conectado, mas NENHUMA mensagem
# chega ao painel — a Evolution entrega em si mesma. Preencha com o
# endereço público do painel e use o botão "Atualizar webhook" na tela
# WhatsApp para reapontar as instâncias já criadas.
EVOLUTION_WEBHOOK_BASE_URL=

# --- Groq (aba Análise por IA) -------------------------
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Meta -----------------------------------------------
# Versão da Graph API usada nas chamadas feitas pelo app.
# Manter alinhada com a usada nos workflows n8n.
META_GRAPH_API_VERSION=v25.0
# Evento de etapa do WhatsApp só sai para lead que veio de anúncio.
# Sem definir, vale 'true' em produção e 'false' em desenvolvimento.
# Defina apenas para inverter esse padrão.
# META_CAPI_EXIGE_ANUNCIO=true

# --- E-mail (convites e redefinição de senha) ----------
# Qualquer provedor SMTP. Sem isso, os convites precisam ser
# copiados manualmente da tela /admin/usuarios.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Fase 6 (cifra de tokens em repouso) ---------------
# Ainda não usada. Chave AES-256: openssl rand -hex 32
# TOKEN_ENCRYPTION_KEY=
